NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Case simulator / test-control (never enable in production)
ENABLE_TEST_CONTROL=true
TEST_CONTROL_SECRET=local-simulator-secret
JOBS_TICK_SECRET=local-simulator-secret
SIMULATOR_BASE_URL=http://127.0.0.1:3000

# Optional jobs worker tuning (see docs/pilot-ops.md)
# JOBS_WORKER_ID=worker-1
# JOBS_BATCH_SIZE=10
# JOBS_POLL_INTERVAL_MS=15000

# Wallet provider (pilot: mock only — see docs/wallet-provider-interface.md)
# WALLET_PROVIDER=mock

# Email channel (Phase 6) — never sends external mail by default
# EMAIL_TRANSPORT=outbox
# EMAIL_TRANSPORT=console
# Enable deliveries via Admin → Feature flags → email_notifications_enabled
